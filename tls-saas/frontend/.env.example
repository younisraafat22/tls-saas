# TLS Appointment Monitor — Frontend Environment
# Copy this file to .env.local and fill in the values

# Backend API URL (used by the frontend to make API calls)
NEXT_PUBLIC_API_URL=https://backend-cold-sound-6496.fly.dev

# Backend WebSocket URL
NEXT_PUBLIC_WS_URL=wss://backend-cold-sound-6496.fly.dev

# VAPID public key for web push notifications
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
