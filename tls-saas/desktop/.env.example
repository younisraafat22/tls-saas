# TLS Appointment Checker - Desktop App Configuration
# Copy this file to .env and fill in your values.

# Backend API URL (where your server is running)
BACKEND_URL=https://backend-cold-sound-6496.fly.dev

# Website URL
WEBSITE_URL=https://tls-saas.vercel.app

# Local desktop security / encryption
SECRET_KEY=
CREDENTIAL_SECRET=
LICENSE_HMAC_SECRET=

# Leave blank to disable developer mode in production builds
DEVELOPER_PASSWORD=

# App settings (optional overrides)
# APP_LOG_LEVEL=INFO

# Optional free IP rotation via local Tor service (falls back to WARP if unavailable)
TOR_ENABLED=true
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=
