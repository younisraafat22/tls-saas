# ===== Backend =====

# Database (SQLite by default, or use PostgreSQL URL)
DATABASE_URL=sqlite+aiosqlite:///./data/tls_saas.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/tls_saas

# JWT Auth
SECRET_KEY=change-this-to-a-long-random-string-at-least-32-chars
JWT_SECRET=change-this-to-a-different-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Admin seed account (created on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# SMTP Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=your-email@gmail.com
SENDER_NAME=TLS Appointment Checker

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Web Push (VAPID keys - generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:your-email@gmail.com

# Checker Settings
CHECK_INTERVAL_MINUTES=5
BROWSER_HEADLESS=true
CLOUDFLARE_WAIT_SECONDS=10
CREDENTIAL_ENCRYPTION_KEY=generate-a-long-random-secret-for-credential-encryption
CREDENTIAL_SECRET=generate-a-long-random-secret-for-desktop-monitoring-server-password-encryption
LICENSE_HMAC_SECRET=generate-a-long-random-secret-for-license-signing
WORKER_SECRET=generate-a-long-random-secret-for-worker-authentication

# Security behavior
# Set to true only if you explicitly want to run with insecure placeholders in local development.
ALLOW_INSECURE_DEFAULTS=false

# Desktop app optional configuration
DEVELOPER_PASSWORD=

# Pricing (EGP)
PRICE_LEGALIZATION=200
PRICE_VISA=200
PRICE_ALL_IN_ONE=300

# CORS
CORS_ORIGINS=http://localhost:3000

# ===== Frontend =====

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
