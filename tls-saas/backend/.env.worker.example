# Worker environment — copy this to backend/.env.worker on the laptop
# and fill in the values.

# URL of your Fly.io deployment (stable forever)
FLY_BACKEND_URL=https://backend-cold-sound-6496.fly.dev

# Shared secret between the laptop worker and the Fly.io API.
# Must match the WORKER_SECRET secret set via: fly secrets set WORKER_SECRET=...
WORKER_SECRET=change-this-to-a-strong-random-secret

# How often to run checks (minutes)
CHECK_INTERVAL_MINUTES=30
